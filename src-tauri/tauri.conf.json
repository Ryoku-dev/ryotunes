{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ryotunes",
  "version": "2.5.1",
  "identifier": "dev.ryoku.ryotunes",
  "build": {
    "frontendDist": "../ui/build",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Ryotunes",
        "width": 1760,
        "height": 1000,
        "center": true,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libmpv2",
          "libc6 (>= 2.39)"
        ]
      },
      "rpm": {
        "depends": [
          "libappindicator-gtk3",
          "mpv-libs"
        ]
      }
    }
  },
  "mainBinaryName": "ryotunes"
}
