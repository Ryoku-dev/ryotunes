--- /dev/null
+++ b/release/rpm/ryoku-ui.spec
@@ -0,0 +1,36 @@
+Name:           ryoku-ui
+Version:        0.1
+Release:        1%{?dist}
+Summary:        Shared Ryoku QML design system
+License:        GPL-3.0-or-later
+URL:            https://ryoku.dev
+Source0:        ryoku-%{version}.tar.gz
+ExclusiveArch:  x86_64 aarch64
+%global debug_package %{nil}
+Requires:       quickshell >= 0.2.1
+Requires:       qt6-qtdeclarative
+Requires:       qt6-qtsvg
+Requires:       qt6-qt5compat
+# Earlier desktop RPMs own these files; upgrade both packages in one transaction.
+Conflicts:      ryoku-desktop < %{version}-%{release}
+
+%description
+The shared Ryoku.Ui QML module, including Ryoku.Ui.Singletons. Its default
+palette works without a running Ryoku desktop. Applications and the desktop
+consume the same module on Fedora's Qt import path.
+
+%prep
+%setup -q -n ryoku-%{version}
+
+%install
+mkdir -p %{buildroot}%{_libdir}/qt6/qml/Ryoku/Ui
+cp -a ryoku/ui/. %{buildroot}%{_libdir}/qt6/qml/Ryoku/Ui/
+rm -f %{buildroot}%{_libdir}/qt6/qml/Ryoku/Ui/install.sh
+find %{buildroot}%{_libdir}/qt6/qml/Ryoku/Ui -name __pycache__ -type d -exec rm -rf {} +
+find %{buildroot}%{_libdir}/qt6/qml/Ryoku/Ui -type d -exec chmod 755 {} +
+find %{buildroot}%{_libdir}/qt6/qml/Ryoku/Ui -type f -exec chmod 644 {} +
+
+%files
+%license LICENSE
+%dir %{_libdir}/qt6/qml/Ryoku
+%{_libdir}/qt6/qml/Ryoku/Ui/
