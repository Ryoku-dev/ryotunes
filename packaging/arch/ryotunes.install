post_install() {
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database -q 2>/dev/null || true
  # The user preset enables ryotunesd.socket for new user managers; a user
  # manager already running gets the enable through its own instance so the
  # very next `ryotunes` lands in the native client without a relogin.
  systemctl --global enable ryotunesd.socket 2>/dev/null || true
  for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
    systemctl --user -M "$uid@" daemon-reload 2>/dev/null || true
    systemctl --user -M "$uid@" enable --now ryotunesd.socket 2>/dev/null || true
  done
}
post_upgrade() {
  post_install
  # Never restart the running app or daemon inside the pacman transaction. A
  # self-update runs this very upgrade over its own RPC to ryotunesd; restarting
  # the daemon here would kill that RPC before it can reply (and could deadlock,
  # since the CLI/staging owner still depends on the running daemon). The socket
  # stays enabled, so the daemon keeps serving the old binary until the user
  # explicitly Quits Ryotunes and reopens it — the next socket activation then
  # starts the new binary. (Closing the window is not enough; the daemon and
  # client must be quit and reopened to load the update.)
}
post_remove() {
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database -q 2>/dev/null || true
  systemctl --global disable ryotunesd.socket 2>/dev/null || true
}
