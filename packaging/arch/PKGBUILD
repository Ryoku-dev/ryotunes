# Local-source PKGBUILD for the Ryotunes release archive.
# Run from packaging/arch with: makepkg -si

pkgname=ryotunes
pkgver=1.0.5
pkgrel=1
# epoch=1 is permanent: the v1 reset publishes 1:X.Y.Z, which pacman ranks above
# the legacy 2.x line an existing machine may carry, so `pacman -U` still upgrades.
# The published asset name stays epochless (scripts/build-arch-package.sh renames
# makepkg's epoch-tagged output back to the ryotunes-<pkgver>-1-x86_64 contract).
epoch=1
pkgdesc="Ryoku's main music app — discover, stream, and enjoy your music collection"
url='https://github.com/ryoku-dev/ryotunes'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=(
  'webkit2gtk-4.1'
  'libappindicator-gtk3'
  'mpv'
  'yt-dlp'
  'ffmpeg'
  'openssl'
  'librsvg'
  'desktop-file-utils'
  'hicolor-icon-theme'
  'xdg-utils'
  'polkit'
  # Required: the native QML client (ryotunes-qml) that `ryotunes` opens on Linux; there is no
  # Tauri fallback, so the client runtime is not optional.
  'quickshell'
)
makedepends=(
  'base-devel'
  'cargo'
  'nodejs'
  'pnpm'
  'appmenu-gtk-module'
  'xdotool'
)
install=ryotunes.install
# makepkg's lto option feeds -flto to the C sources cc builds for the vendored sqlite and ring;
# rustc links with lld, which cannot read GCC LTO objects (undefined sqlite3_* / ring_core_*).
# !debug: the release ships exactly the one contracted asset (ryotunes-<ver>-1-x86_64.pkg.tar.zst),
# never a second ryotunes-debug-* package, regardless of the builder's makepkg.conf.
options=(!lto !debug)
source=()
sha256sums=()

prepare() {
  local root
  root="$(cd "$startdir/../.." && pwd)"
  rm -rf "$srcdir/ryotunes"
  mkdir -p "$srcdir/ryotunes"
  tar \
    --exclude='.git' \
    --exclude='target' \
    --exclude='ui/node_modules' \
    --exclude='ui/build' \
    --exclude='ui/.svelte-kit' \
    --exclude='./packaging/arch/pkg' \
    --exclude='./packaging/arch/src' \
    --exclude='./packaging/arch/*.pkg.tar.*' \
    -C "$root" -cf - . | tar -C "$srcdir/ryotunes" -xf -
}

build() {
  cd "$srcdir/ryotunes/ui"
  pnpm install --frozen-lockfile
  pnpm build

  cd "$srcdir/ryotunes"
  cargo build --release --locked --package ryotunes --package sync-server --package ryotunesd --package ryotunes-cli
}

check() {
  cd "$srcdir/ryotunes"
  cargo test --workspace --locked
  cd ui
  pnpm check
}

package() {
  cd "$srcdir/ryotunes"
  local binaries="${CARGO_TARGET_DIR:-target}/release"
  install -Dm755 "$binaries/ryotunes" "$pkgdir/usr/bin/ryotunes"
  install -Dm755 "$binaries/ryotunes-sync" "$pkgdir/usr/bin/ryotunes-sync"
  install -Dm755 "$binaries/ryotunesd" "$pkgdir/usr/bin/ryotunesd"
  install -Dm755 "$binaries/ryotunes-cli" "$pkgdir/usr/bin/ryotunes-cli"
  install -Dm755 packaging/linux/ryotunes-qml "$pkgdir/usr/bin/ryotunes-qml"
  # Native QML client, run by Quickshell via `qs -p /usr/share/ryotunes/client` (the ryotunes-qml
  # launcher); ship the whole config tree minus the QtTest sources, world-readable.
  install -dm755 "$pkgdir/usr/share/ryotunes"
  cp -r client "$pkgdir/usr/share/ryotunes/client"
  rm -rf "$pkgdir/usr/share/ryotunes/client/tests"
  find "$pkgdir/usr/share/ryotunes/client" -type d -exec chmod 755 {} +
  find "$pkgdir/usr/share/ryotunes/client" -type f -exec chmod 644 {} +
  # Shipped skins (skin.json + preview.png + the schema/README) and the matugen template, so the
  # client's shipped skin dir (<shellDir>/../skins) and `/usr/share/ryotunes/matugen` resolve.
  install -dm755 "$pkgdir/usr/share/ryotunes/skins"
  cp -r skins/. "$pkgdir/usr/share/ryotunes/skins/"
  find "$pkgdir/usr/share/ryotunes/skins" -type d -exec chmod 755 {} +
  find "$pkgdir/usr/share/ryotunes/skins" -type f -exec chmod 644 {} +
  install -Dm644 matugen/ryotunes.json "$pkgdir/usr/share/ryotunes/matugen/ryotunes.json"
  install -Dm644 packaging/linux/ryotunesd.socket "$pkgdir/usr/lib/systemd/user/ryotunesd.socket"
  install -Dm644 packaging/linux/ryotunesd.service "$pkgdir/usr/lib/systemd/user/ryotunesd.service"
  install -Dm644 packaging/linux/90-ryotunes.preset "$pkgdir/usr/lib/systemd/user-preset/90-ryotunes.preset"
  install -Dm644 packaging/linux/ryotunes.desktop "$pkgdir/usr/share/applications/ryotunes.desktop"
  install -Dm644 packaging/linux/dev.ryoku.ryotunes.metainfo.xml "$pkgdir/usr/share/metainfo/dev.ryoku.ryotunes.metainfo.xml"
  install -Dm644 src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/ryotunes.png"
  install -Dm644 src-tauri/icons/64x64.png "$pkgdir/usr/share/icons/hicolor/64x64/apps/ryotunes.png"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/ryotunes.png"
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/ryotunes.png"
  install -Dm644 src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/ryotunes.png"
  install -Dm755 scripts/diagnostics.sh "$pkgdir/usr/bin/ryotunes-diagnostics"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/ryotunes/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/ryotunes/README.md"
  install -Dm644 UPSTREAM.md "$pkgdir/usr/share/doc/ryotunes/UPSTREAM.md"
}
